# Telegram API credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# App access password (for unlocking the web interface)
TGFEED_APP_PASSWORD=

# Secret key for session cookie encryption (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
TGFEED_SECRET_KEY=

# SQLite path (mounted to a volume in Docker or local path)
TGFEED_DB_PATH=./tgfeed.db

# Ingestion settings
TGFEED_HN_ENABLED=true
TGFEED_RSS_ENABLED=true
TGFEED_X_ENABLED=false

# Gemini AI Settings (for automatic summarization)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
